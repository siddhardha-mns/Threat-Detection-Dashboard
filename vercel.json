{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "vite build"
    },
    "api": {
      "root": ".",
      "framework": "express",
      "buildCommand": "node --check server.js",
      "entrypoint": "server.js"
    },
    "threat-dashboard": {
      "root": "threat-dashboard",
      "runtime": "container",
      "entrypoint": "Dockerfile"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/dashboard",
      "destination": {
        "service": "threat-dashboard"
      }
    },
    {
      "source": "/dashboard/(.*)",
      "destination": {
        "service": "threat-dashboard"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
